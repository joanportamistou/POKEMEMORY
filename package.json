{
  "name": "pokememory",
  "version": "1.0.0",
  "description": "Joc del Memory amb imatges de pokemons (JS Vanilla)",
  "type": "module",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "lint": "eslint \"js/**/*.js\"",
    "lint:html": "htmlhint \"*.html\"",
    "test:e2e": "start-server-and-test start http://localhost:8080 \"cypress run\"",
    "test:e2e:open": "start-server-and-test start http://localhost:8080 \"cypress open\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cypress": "^13.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.1.4",
    "http-server": "^14.1.1",
    "start-server-and-test": "^2.0.9"
  }
}
